# ==============================================================================
# EduSmart Backend Configuration Placeholder (.env.example)
# Copy this file to .env before starting the backend in development.
# ==============================================================================

# Server Network Settings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ENVIRONMENT=development
DEBUG=true

# Frontend Integration & CORS
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Apache Jena Fuseki SPARQL Server Settings (Planned for Phase 2+)
# Base URL for the Apache Jena Fuseki server
FUSEKI_BASE_URL=http://localhost:3030
# Name of the target Fuseki dataset (e.g., edusmart)
FUSEKI_DATASET=edusmart
# Full SPARQL query endpoint URL
FUSEKI_QUERY_ENDPOINT=http://localhost:3030/edusmart/query
# Full SPARQL update endpoint URL
FUSEKI_UPDATE_ENDPOINT=http://localhost:3030/edusmart/update

# Semantic Web & Ontology File Paths
# Path to the primary RDF/OWL ontology file (relative or absolute)
ONTOLOGY_FILE_PATH=./ontology/EduSmart_5Niveaux_Toutes_Branches_Corrige.rdf
# Default graph URI for the Education and Training domain ontology
ONTOLOGY_DEFAULT_GRAPH_URI=http://www.semanticweb.org/msi/ontologies/2026/9/Education_Formation#

# Natural Language Processing / TALN Settings (Planned for Phase 2+)
# spaCy model name to load for question analysis (e.g., en_core_web_sm or fr_core_news_sm)
SPACY_MODEL=en_core_web_sm
