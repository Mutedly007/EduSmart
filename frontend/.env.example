# Backend FastAPI Base URL
VITE_API_BASE_URL=http://localhost:8000

# Standby SPARQL Endpoint URL (informational, not directly queried from frontend in Phase 1)
VITE_FUSEKI_SPARQL_URL=http://localhost:3030/edusmart/query

# Application Environment
VITE_APP_ENV=development
